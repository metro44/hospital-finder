# Copy to .env (or .env.local) and fill in.

# Google Maps browser key — only the "Maps JavaScript API" is needed (for the
# interactive map tiles). Directions and place search use free non-Google APIs,
# so this key does NOT need the Directions or Places APIs enabled. Restrict it
# by HTTP referrer. If omitted, the map shows a fallback and search still works.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# openrouteservice API key — powers turn-by-turn directions. Free, no credit
# card: sign up at https://openrouteservice.org/dev/ (2000 routes/day).
# Server-side only (not exposed to the browser). Directions are disabled without it.
ORS_API_KEY=your_openrouteservice_key

# Clerk (authentication) — used for saving hospitals
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_SECRET_KEY

# Postgres connection string for Prisma. NOTE: the datasource reads env("DATA"),
# not DATABASE_URL (see prisma/schema.prisma).
DATA="postgresql://user:password@host/db?sslmode=require"

# Hospital search (Overpass + Nominatim) and place autocomplete (Photon) use
# free OpenStreetMap-based APIs and need no key.
